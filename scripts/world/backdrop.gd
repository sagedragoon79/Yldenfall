class_name Backdrop
extends Node2D
## The parallax background behind a room: a far layer, a distant ridge layer and
## a mid layer per zone (generated by tools/art/tilegen.py into assets/bg/),
## scrolling slower than the camera and repeating sideways.

const DIR := "res://assets/bg/"
const ATMOS_SHADER := preload("res://shaders/atmosphere.gdshader")
const FORE_SHADER := preload("res://shaders/fore_reveal.gdshader")
## Layer suffix -> scroll speed relative to the camera. Insertion order is also
## draw order (back to front): far sits furthest back and scrolls slowest, the
## ridge sits between, mid is nearest. The ridge (design bible 12.12) is a
## distant silhouette ridgeline that deepens the parallax from two depths to
## three, so the play field reads clear of the backdrop.
const LAYERS := {"far": Vector2(0.15, 0.1), "ridge": Vector2(0.26, 0.19), "mid": Vector2(0.4, 0.3)}
## Atmospheric perspective per layer (design bible 12.5): the further-back layer
## is pulled harder toward grey (desat) and toward the dark haze (fade), so it
## reads as distance and the lit gameplay tiles pop against it. The knobs step
## down with depth — `far` furthest and strongest, the `ridge` between, `mid`
## nearest and lightest — so the three layers recede in order.
const ATMOS := {
	"far": {"desat": 0.55, "fade": 0.5},
	"ridge": {"desat": 0.42, "fade": 0.37},
	"mid": {"desat": 0.3, "fade": 0.24},
}
## The default dark haze the layers fade toward when a zone has no entry in
## ZONE_HAZE (gym, or any new zone): night-1 from the master palette
## (tools/art/palette.py), the deep blue-violet of every zone's shadows.
const HAZE := Color8(44, 37, 65)
## Per-zone distance-fog colour (design bible 12.5): the dark haze each zone's
## parallax layers recede into, so a zone reads with its own atmosphere instead
## of one shared night. Each is a low shade of the zone's dominant master-palette
## hue blended halfway toward night-1 (HAZE) — tinted for identity, anchored to
## the shared night for cohesion. Warm hearths (hearthroot, spires), green woods
## (heartwood, boughs), cold spring-blue (haar, sunken), crystal violet
## (evercrown, vorrhallow) and bare grey stone (tower, trials). Computed from the
## palette in tools/art/palette.py; mirror any change there.
##
## The two murkiest zones (haar, sunken) are eased toward neutral (pass 513): the
## independent grade read them as a low-contrast grey-green / grey-teal where the
## play field and backdrop merged. Their haze is desaturated so the dark backdrop
## recedes as a paler mist (higher luminance at the same dark HSV value, still
## under the `.v < 0.4` dark-tone cap and still cool-blue), lifting its separation
## from the play field while the tiles, hazards and foes — all drawn in front and
## untouched by the haze — keep their contrast.
const ZONE_HAZE := {
	"hearthroot": Color8(58, 34, 48),
	"heartwood": Color8(37, 54, 51),
	"tower": Color8(46, 40, 62),
	"haar": Color8(74, 84, 98),
	"boughs": Color8(43, 83, 53),
	"vorrhallow": Color8(46, 39, 69),
	"evercrown": Color8(55, 34, 68),
	"sunken": Color8(56, 62, 80),
	"trials": Color8(46, 40, 62),
	"spires": Color8(64, 37, 42),
}
const SIZE := Vector2(640, 480)
## Starts the layers a little above the room's top so vertical scrolling never shows a gap.
const OFFSET := Vector2(0, -60)

## The foreground silhouette layer (design bible 12.11): the zone's dark near-black
## material (ferns, reeds, crystals, rubble, posts; tools/art/tilegen.py paints
## <zone>_fore.png) drawn in front of the play field. It scrolls FASTER than the
## camera horizontally (x > 1) so it reads as near and slides past as the player
## walks, and is locked to the camera vertically so the silhouettes always rise
## from the bottom edge of the view.
##
## A Parallax2D axis with no repeat sits at `screen_offset * (1 - scroll_scale)`:
## scale 1 pins it to the WORLD, scale 0 pins it to the CAMERA. The vertical scale
## was 1 until pass 528, which left the art's solid ground band fixed at world
## y 344..480: a 16 px black strip along the bottom of a one-screen room, and a
## near-opaque black band 136 px tall across every taller room (Sean's note, and
## the grade's "letterbox"), in front of its platforms and foes.
const FORE_SCROLL := Vector2(1.5, 0.0)
## An absolute z above the atmosphere overlays (fog/motes/rain sit at 4) and every
## actor and projectile (<= 3), so the foreground is the nearest thing on screen.
const FORE_Z := 5
## The y, in the art's world pixels, where the solid ground band starts and the
## silhouettes root (tools/art/tilegen.py: FORE_FLOOR - FORE_BAND, over D).
const FORE_GROUND := 344.0
## The height of the view at the normal framing (GameCamera.view_size.y), in world pixels.
const VIEW_HEIGHT := 360.0
## The foreground thins in front of actors (design bible 12.26): the groups whose
## members it reveals, how much of a silhouette is left in front of one, the
## padding around each actor's box and the soft edge beyond it (world pixels), and
## how many actors at most (the nearest to the view's centre; mirrors
## MAX_HOLES in shaders/fore_reveal.gdshader).
const REVEAL_GROUPS := ["player", "npc", "enemy", "boss"]
const REVEAL_KEEP := 0.2
const REVEAL_PAD := 4.0
const REVEAL_SOFT := 8.0
const MAX_HOLES := 16
## An actor's box when it has no collision shape to measure (a townsperson, whose
## origin is its feet): about a person's width and height.
const PERSON_BOX := Rect2(-12, -46, 24, 46)

var zone := ""
## The foreground layer of the current zone, or null (see _process).
var _fore: Parallax2D



func _ready() -> void:
	z_index = -50


func set_zone(next: String) -> void:
	if next == zone:
		return
	zone = next
	for c in get_children():
		c.queue_free()
	for suffix: String in LAYERS:
		var path := DIR + "%s_%s.png" % [zone, suffix]
		if not ResourceLoader.exists(path):
			continue
		var layer := Parallax2D.new()
		layer.scroll_scale = LAYERS[suffix]
		layer.repeat_size = Vector2(SIZE.x, 0)
		layer.repeat_times = 3
		layer.ignore_camera_scroll = true
		var sprite := Sprite2D.new()
		sprite.texture = load(path)
		# Painted at the render density (design bible 12.1): scale back to world pixels.
		sprite.scale = SIZE / sprite.texture.get_size()
		sprite.centered = false
		sprite.position = OFFSET
		sprite.material = atmos_material(suffix, haze_for(zone))
		layer.add_child(sprite)
		add_child(layer)
	_fore = fore_layer(zone)
	if _fore != null:
		add_child(_fore)


## The foreground silhouette layer for a zone (design bible 12.11), or null when
## the zone has no <zone>_fore.png (gym, or any new zone). A Parallax2D that
## scrolls fast horizontally and is locked vertically (FORE_SCROLL), drawn at an
## absolute z in front of everything (FORE_Z), with the zone's silhouette art.
static func fore_layer(a_zone: String) -> Parallax2D:
	var path := DIR + "%s_fore.png" % a_zone
	if not ResourceLoader.exists(path):
		return null
	var layer := Parallax2D.new()
	layer.scroll_scale = FORE_SCROLL
	layer.repeat_size = Vector2(SIZE.x, 0)
	layer.repeat_times = 3
	layer.ignore_camera_scroll = true
	layer.z_as_relative = false
	layer.z_index = FORE_Z
	var sprite := Sprite2D.new()
	sprite.texture = load(path)
	# Painted at the render density (design bible 12.1): scale back to world pixels.
	sprite.scale = SIZE / sprite.texture.get_size()
	sprite.centered = false
	sprite.position = fore_offset(VIEW_HEIGHT)
	sprite.material = fore_material()
	layer.add_child(sprite)
	return layer


## The foreground's reveal material (design bible 12.26): no holes until
## _process feeds the actors in view.
static func fore_material() -> ShaderMaterial:
	var mat := ShaderMaterial.new()
	mat.shader = FORE_SHADER
	mat.set_shader_parameter("size", SIZE)
	mat.set_shader_parameter("keep", REVEAL_KEEP)
	mat.set_shader_parameter("soft", REVEAL_SOFT)
	mat.set_shader_parameter("hole_count", 0)
	return mat


## An actor's box in world pixels: its first rectangle or capsule collision shape
## (the hero, a foe), or PERSON_BOX at its feet (a townsperson), grown by REVEAL_PAD.
static func actor_box(actor: Node2D) -> Rect2:
	var box := Rect2(actor.global_position + PERSON_BOX.position, PERSON_BOX.size)
	for c in actor.get_children():
		if c is CollisionShape2D and c.shape != null:
			var sz := Vector2.ZERO
			if c.shape is RectangleShape2D:
				sz = (c.shape as RectangleShape2D).size
			elif c.shape is CapsuleShape2D:
				var cap := c.shape as CapsuleShape2D
				sz = Vector2(cap.radius * 2.0, cap.height)
			if sz != Vector2.ZERO:
				var centre: Vector2 = (c as CollisionShape2D).global_position
				box = Rect2(centre - sz * 0.5, sz)
				break
	return box.grow(REVEAL_PAD)


## The holes for the foreground sprite `sprite`, one per actor box in `boxes`:
## (centre u, centre v, half width, half height), the centre in the art's UV and the
## half sizes in world pixels, as shaders/fore_reveal.gdshader reads them.
static func holes_for(sprite: Sprite2D, boxes: Array[Rect2]) -> Array[Vector4]:
	var out: Array[Vector4] = []
	var to_local := sprite.get_global_transform().affine_inverse()
	var tex_size := sprite.texture.get_size()
	for b in boxes:
		var uv := (to_local * b.get_center()) / tex_size
		out.append(Vector4(uv.x, uv.y, b.size.x * 0.5, b.size.y * 0.5))
	return out


## How much of the foreground is thinned at `uv` (0 none, 1 full) by `holes`.
## Mirrors shaders/fore_reveal.gdshader exactly, so the tests can drive its maths.
static func reveal_mask(uv: Vector2, holes: Array[Vector4], size: Vector2 = SIZE, soft: float = REVEAL_SOFT) -> float:
	var m := 0.0
	for h in holes:
		var du := absf(fposmod(uv.x - h.x + 0.5, 1.0) - 0.5) * size.x
		var dv := absf(uv.y - h.y) * size.y
		var out_d := Vector2(maxf(du - h.z, 0.0), maxf(dv - h.w, 0.0))
		m = maxf(m, 1.0 - smoothstep(0.0, soft, out_d.length()))
	return m


## The boxes of the actors the view shows (REVEAL_GROUPS), nearest to the view's
## centre first, at most MAX_HOLES.
func _actor_boxes(view: Rect2) -> Array[Rect2]:
	var found: Array = []
	var seen := {}
	for g: String in REVEAL_GROUPS:
		for n in get_tree().get_nodes_in_group(g):
			if seen.has(n) or not (n is Node2D) or not (n as Node2D).is_visible_in_tree():
				continue
			seen[n] = true
			var b := actor_box(n as Node2D)
			if view.intersects(b):
				found.append([b.get_center().distance_squared_to(view.get_center()), b])
	found.sort_custom(func(a: Array, b: Array) -> bool: return a[0] < b[0])
	var out: Array[Rect2] = []
	for f in found.slice(0, MAX_HOLES):
		out.append(f[1])
	return out


## Where the foreground art sits below the top of a view `view_height` world
## pixels tall: its ground line lands exactly on the view's bottom edge, so the
## silhouettes rise from the edge and the solid band under them (which only backs
## their roots) stays off screen at any framing — the normal 360 or a wide room's 450.
static func fore_offset(view_height: float) -> Vector2:
	return Vector2(0, view_height - FORE_GROUND)


## The distance-fog colour a zone's layers recede into: its ZONE_HAZE entry, or
## the default night haze for a zone with none.
static func haze_for(a_zone: String) -> Color:
	return ZONE_HAZE.get(a_zone, HAZE)


## The atmospheric-perspective material for a layer, or null if the suffix has no
## entry (then the layer draws as painted). `haze` is the zone's distance-fog
## colour (defaults to the shared night haze).
static func atmos_material(suffix: String, haze: Color = HAZE) -> ShaderMaterial:
	if not ATMOS.has(suffix):
		return null
	var mat := ShaderMaterial.new()
	mat.shader = ATMOS_SHADER
	mat.set_shader_parameter("desat", ATMOS[suffix]["desat"])
	mat.set_shader_parameter("fade", ATMOS[suffix]["fade"])
	mat.set_shader_parameter("haze", haze)
	return mat


## The colour the atmosphere shader produces for one source pixel: pull toward
## grey by `desat`, then toward the dark `haze` by `fade`. This mirrors
## shaders/atmosphere.gdshader exactly, so the tests can drive the shader's maths.
static func haze_color(src: Color, desat: float, fade: float, haze: Color) -> Color:
	var lum := src.r * 0.299 + src.g * 0.587 + src.b * 0.114
	var out := Color(
		lerpf(src.r, lum, desat),
		lerpf(src.g, lum, desat),
		lerpf(src.b, lum, desat),
		src.a,
	)
	return Color(
		lerpf(out.r, haze.r, fade),
		lerpf(out.g, haze.g, fade),
		lerpf(out.b, haze.b, fade),
		src.a,
	)


## Parallax2D reads the camera scroll in render pixels, which is GameCamera.DETAIL
## times too far once the camera zooms, so the layers get it in world pixels.
## The foreground is then seated on the bottom edge of whatever the view shows.
func _process(_delta: float) -> void:
	var vp := get_viewport()
	var t := vp.get_canvas_transform()
	var offset := -t.origin / t.get_scale()
	for layer in get_children():
		(layer as Parallax2D).screen_offset = offset
	if _fore != null and is_instance_valid(_fore) and _fore.get_child_count() > 0:
		var view_size := vp.get_visible_rect().size / t.get_scale()
		var sprite := _fore.get_child(0) as Sprite2D
		sprite.position = fore_offset(view_size.y)
		# Thin the silhouettes in front of the actors in view (design bible 12.26).
		var holes := holes_for(sprite, _actor_boxes(Rect2(offset, view_size)))
		var mat := sprite.material as ShaderMaterial
		if mat != null:
			var packed: Array[Vector4] = holes.duplicate()
			packed.resize(MAX_HOLES)
			mat.set_shader_parameter("holes", packed)
			mat.set_shader_parameter("hole_count", holes.size())
