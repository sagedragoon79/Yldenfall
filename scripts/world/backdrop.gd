class_name Backdrop
extends Node2D
## The parallax background behind a room: a far layer, a distant ridge layer and
## a mid layer per zone (generated by tools/art/tilegen.py into assets/bg/),
## scrolling slower than the camera and repeating sideways.

const DIR := "res://assets/bg/"
const ATMOS_SHADER := preload("res://shaders/atmosphere.gdshader")
## Layer suffix -> scroll speed relative to the camera. Insertion order is also
## draw order (back to front): far sits furthest back and scrolls slowest, the
## ridge sits between, mid is nearest. The ridge (design bible 12.12) is a
## distant silhouette ridgeline that deepens the parallax from two depths to
## three, so the play field reads clear of the backdrop.
const LAYERS := {"far": Vector2(0.15, 0.1), "ridge": Vector2(0.26, 0.19), "mid": Vector2(0.4, 0.3)}
## Atmospheric perspective per layer (design bible 12.5): the further-back layer
## is pulled harder toward grey (desat) and toward the dark haze (fade), so it
## reads as distance and the lit gameplay tiles pop against it. The knobs step
## down with depth — `far` furthest and strongest, the `ridge` between, `mid`
## nearest and lightest — so the three layers recede in order.
const ATMOS := {
	"far": {"desat": 0.55, "fade": 0.5},
	"ridge": {"desat": 0.42, "fade": 0.37},
	"mid": {"desat": 0.3, "fade": 0.24},
}
## The default dark haze the layers fade toward when a zone has no entry in
## ZONE_HAZE (gym, or any new zone): night-1 from the master palette
## (tools/art/palette.py), the deep blue-violet of every zone's shadows.
const HAZE := Color8(44, 37, 65)
## Per-zone distance-fog colour (design bible 12.5): the dark haze each zone's
## parallax layers recede into, so a zone reads with its own atmosphere instead
## of one shared night. Each is a low shade of the zone's dominant master-palette
## hue blended halfway toward night-1 (HAZE) — tinted for identity, anchored to
## the shared night for cohesion. Warm hearths (hearthroot, spires), green woods
## (heartwood, boughs), cold spring-blue (haar, sunken), crystal violet
## (evercrown, vorrhallow) and bare grey stone (tower, trials). Computed from the
## palette in tools/art/palette.py; mirror any change there.
const ZONE_HAZE := {
	"hearthroot": Color8(58, 34, 48),
	"heartwood": Color8(37, 54, 51),
	"tower": Color8(46, 40, 62),
	"haar": Color8(44, 60, 92),
	"boughs": Color8(43, 83, 53),
	"vorrhallow": Color8(46, 39, 69),
	"evercrown": Color8(55, 34, 68),
	"sunken": Color8(37, 43, 68),
	"trials": Color8(46, 40, 62),
	"spires": Color8(64, 37, 42),
}
const SIZE := Vector2(640, 480)
## Starts the layers a little above the room's top so vertical scrolling never shows a gap.
const OFFSET := Vector2(0, -60)

## The foreground silhouette layer (design bible 12.11): the zone's dark near-black
## material (ferns, reeds, crystals, rubble, posts; tools/art/tilegen.py paints
## <zone>_fore.png) drawn in front of the play field. It scrolls FASTER than the
## camera horizontally (x > 1) so it reads as near and slides past as the player
## walks, and is locked to the camera vertically (y = 1) so the silhouette band
## always frames the bottom of the view with no gap. The art is anchored to the
## view bottom, so the layer draws from the camera top with no vertical offset.
const FORE_SCROLL := Vector2(1.5, 1.0)
## An absolute z above the atmosphere overlays (fog/motes/rain sit at 4) and every
## actor and projectile (<= 3), so the foreground is the nearest thing on screen.
const FORE_Z := 5
const FORE_OFFSET := Vector2(0, 0)

var zone := ""


func _ready() -> void:
	z_index = -50


func set_zone(next: String) -> void:
	if next == zone:
		return
	zone = next
	for c in get_children():
		c.queue_free()
	for suffix: String in LAYERS:
		var path := DIR + "%s_%s.png" % [zone, suffix]
		if not ResourceLoader.exists(path):
			continue
		var layer := Parallax2D.new()
		layer.scroll_scale = LAYERS[suffix]
		layer.repeat_size = Vector2(SIZE.x, 0)
		layer.repeat_times = 3
		layer.ignore_camera_scroll = true
		var sprite := Sprite2D.new()
		sprite.texture = load(path)
		# Painted at the render density (design bible 12.1): scale back to world pixels.
		sprite.scale = SIZE / sprite.texture.get_size()
		sprite.centered = false
		sprite.position = OFFSET
		sprite.material = atmos_material(suffix, haze_for(zone))
		layer.add_child(sprite)
		add_child(layer)
	var fore := fore_layer(zone)
	if fore != null:
		add_child(fore)


## The foreground silhouette layer for a zone (design bible 12.11), or null when
## the zone has no <zone>_fore.png (gym, or any new zone). A Parallax2D that
## scrolls fast horizontally and is locked vertically (FORE_SCROLL), drawn at an
## absolute z in front of everything (FORE_Z), with the zone's silhouette art.
static func fore_layer(a_zone: String) -> Parallax2D:
	var path := DIR + "%s_fore.png" % a_zone
	if not ResourceLoader.exists(path):
		return null
	var layer := Parallax2D.new()
	layer.scroll_scale = FORE_SCROLL
	layer.repeat_size = Vector2(SIZE.x, 0)
	layer.repeat_times = 3
	layer.ignore_camera_scroll = true
	layer.z_as_relative = false
	layer.z_index = FORE_Z
	var sprite := Sprite2D.new()
	sprite.texture = load(path)
	# Painted at the render density (design bible 12.1): scale back to world pixels.
	sprite.scale = SIZE / sprite.texture.get_size()
	sprite.centered = false
	sprite.position = FORE_OFFSET
	layer.add_child(sprite)
	return layer


## The distance-fog colour a zone's layers recede into: its ZONE_HAZE entry, or
## the default night haze for a zone with none.
static func haze_for(a_zone: String) -> Color:
	return ZONE_HAZE.get(a_zone, HAZE)


## The atmospheric-perspective material for a layer, or null if the suffix has no
## entry (then the layer draws as painted). `haze` is the zone's distance-fog
## colour (defaults to the shared night haze).
static func atmos_material(suffix: String, haze: Color = HAZE) -> ShaderMaterial:
	if not ATMOS.has(suffix):
		return null
	var mat := ShaderMaterial.new()
	mat.shader = ATMOS_SHADER
	mat.set_shader_parameter("desat", ATMOS[suffix]["desat"])
	mat.set_shader_parameter("fade", ATMOS[suffix]["fade"])
	mat.set_shader_parameter("haze", haze)
	return mat


## The colour the atmosphere shader produces for one source pixel: pull toward
## grey by `desat`, then toward the dark `haze` by `fade`. This mirrors
## shaders/atmosphere.gdshader exactly, so the tests can drive the shader's maths.
static func haze_color(src: Color, desat: float, fade: float, haze: Color) -> Color:
	var lum := src.r * 0.299 + src.g * 0.587 + src.b * 0.114
	var out := Color(
		lerpf(src.r, lum, desat),
		lerpf(src.g, lum, desat),
		lerpf(src.b, lum, desat),
		src.a,
	)
	return Color(
		lerpf(out.r, haze.r, fade),
		lerpf(out.g, haze.g, fade),
		lerpf(out.b, haze.b, fade),
		src.a,
	)


## Parallax2D reads the camera scroll in render pixels, which is GameCamera.DETAIL
## times too far once the camera zooms, so the layers get it in world pixels.
func _process(_delta: float) -> void:
	var t := get_viewport().get_canvas_transform()
	var offset := -t.origin / t.get_scale()
	for layer in get_children():
		(layer as Parallax2D).screen_offset = offset
